{
	"name": "ut-launcher",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "./src/backend/main.cjs",
	"author": {
		"name": "P1ayer"
	},
	"description": "ut-app",
	"scripts": {
		"start": "concurrently --kill-others --names vite,electron -c green,cyan --handle-input --default-input-target electron  \"npm run vite:dev\" \"npm run electron:dev\"",
		"start:debug": "cross-env REACTSCAN=true npm run start",
		"build": "npm run vite:build && npm run electron:package",
		"make": "npm run vite:build && npm run electron:make",
		"lint": "eslint .",
		"bump": "ncu -u -x electron-store,@electron/fuses",
		"vite:dev": "vite",
		"vite:build": "vite build",
		"vite:preview": "vite preview",
		"vite:blank": "cross-env VITE_BLANK=true vite",
		"electron:start": "electron-forge start",
		"electron:dev": "cross-env DEV=true electron-forge start",
		"electron:package": "electron-forge package",
		"electron:make": "electron-forge make"
	},
	"//": [
		"Do not bump 'electron-store@7.0.0' to latest version, it doesn't work because it's ESM converted",
		"Keep @electron/fuses at 1.8.0 for now, the latest one throws errors"
	],
	"dependencies": {
		"axios": "^1.13.2",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^7.0.0",
		"ini": "^6.0.0",
		"js7z-tools": "^2.5.0",
		"node-screenshots": "^0.2.1"
	},
	"icon": "./public/icon/icon",
	"devDependencies": {
		"@electron-forge/cli": "^7.10.2",
		"@electron-forge/maker-deb": "^7.10.2",
		"@electron-forge/maker-rpm": "^7.10.2",
		"@electron-forge/maker-squirrel": "^7.10.2",
		"@electron-forge/maker-zip": "^7.10.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
		"@electron-forge/plugin-fuses": "^7.10.2",
		"@electron/fuses": "^1.8.0",
		"@eslint/js": "^9.39.1",
		"@firefox-devtools/react-contextmenu": "^5.2.3",
		"@tanstack/eslint-plugin-query": "^5.91.2",
		"@tanstack/react-query": "^5.90.10",
		"@types/react": "^19.2.6",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"electron": "^39.2.3",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"npm-check-updates": "^19.1.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-icons": "^5.5.0",
		"react-modal": "^3.16.3",
		"react-scan": "^0.4.3",
		"sass-embedded": "^1.93.3",
		"vite": "^7.2.4",
		"zustand": "^5.0.8"
	}
}
