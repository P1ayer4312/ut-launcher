{
  "name": "ut-launcher",
  "productName": "UT Launcher",
  "version": "0.0.1",
  "description": "Standalone launcher for downloading and patching games from the Unreal series",
  "main": ".vite/build/main.js",
  "icon": "./public/icon/icon",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:debug": "electron-forge start --inspect-electron",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint ./src",
    "vite": "vite --config ./vite.renderer.config.mts",
    "cloc": "cloc --exclude-ext=ini ./src"
  },
  "keywords": [],
  "author": {
    "name": "P1ayer"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@firefox-devtools/react-contextmenu": "^5.2.4",
    "@octokit/types": "^18.0.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cloc": "^2.6.0-cloc",
    "electron": "^44.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-scan": "^0.5.7",
    "react-toastify": "^11.1.0",
    "sass-embedded": "^1.104.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "tar": "^7.4.3",
    "tmp": "^0.2.6"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "innoextract-wasm": "file:modules/innoextract-wasm",
    "jimp": "^1.6.1",
    "js7z-tools": "^2.5.0",
    "react-tooltip": "^6.0.8"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "electron-winstaller": true
  }
}
