{
  "name": "ut-launcher",
  "productName": "UT Launcher",
  "version": "0.0.1",
  "description": "Standalone launcher for downloading and patching games from the Unreal series",
  "main": ".vite/build/main.cjs",
  "icon": "./public/icon/icon",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:debug": "electron-forge start --inspect-electron",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint ./src",
    "vite": "vite --config ./vite.renderer.config.mts",
    "cloc": "cloc --exclude-ext=ini ./src"
  },
  "keywords": [],
  "author": {
    "name": "P1ayer"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@firefox-devtools/react-contextmenu": "^5.2.4",
    "@octokit/types": "^18.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cloc": "^2.10.0-cloc",
    "electron": "^45.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-scan": "^0.5.7",
    "react-toastify": "^11.1.0",
    "sass-embedded": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "tar": "^7.4.3",
    "tmp": "^0.2.6",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "innoextract-wasm": "file:modules/innoextract-wasm",
    "jimp": "^1.6.1",
    "js7z-tools": "^2.5.0",
    "react-tooltip": "^6.0.9"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "electron-winstaller": true
  }
}
