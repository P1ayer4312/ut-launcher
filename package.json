{
	"name": "ut-launcher",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "./src/backend/main.cjs",
	"author": {
		"name": "P1ayer"
	},
	"description": "ut-app",
	"scripts": {
		"start": "concurrently --kill-others --names vite,electron -c green,cyan \"npm run vite:dev\" \"npm run electron:dev\"",
		"build": "npm run vite:build && npm run electron:package",
		"make": "npm run vite:build && npm run electron:make",
		"lint": "eslint .",
		"bump": "ncu -u -x electron-store",
		"vite:dev": "vite",
		"vite:build": "vite build",
		"vite:preview": "vite preview",
		"electron:start": "electron-forge start",
		"electron:dev": "electron-forge start -- --dev",
		"electron:package": "electron-forge package",
		"electron:make": "electron-forge make"
	},
	"//": [
		"Do not bump 'electron-store@7.0.0' to latest version, it doesn't work because it's ESM converted"
	],
	"dependencies": {
		"@dotenvx/dotenvx": "^1.45.1",
		"axios": "^1.10.0",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^7.0.0",
		"js7z-tools": "^2.4.1",
		"node-screenshots": "^0.2.1"
	},
	"icon": "./public/icon/icon",
	"devDependencies": {
		"@electron-forge/cli": "^7.8.1",
		"@electron-forge/maker-deb": "^7.8.1",
		"@electron-forge/maker-rpm": "^7.8.1",
		"@electron-forge/maker-squirrel": "^7.8.1",
		"@electron-forge/maker-zip": "^7.8.1",
		"@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
		"@electron-forge/plugin-fuses": "^7.8.1",
		"@electron/fuses": "^1.8.0",
		"@eslint/js": "^9.29.0",
		"@firefox-devtools/react-contextmenu": "^5.2.2",
		"@tanstack/eslint-plugin-query": "^5.81.2",
		"@tanstack/react-query": "^5.81.5",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"concurrently": "^9.2.0",
		"electron": "^37.1.0",
		"eslint": "^9.29.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.2.0",
		"npm-check-updates": "^18.0.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sass-embedded": "^1.89.2",
		"vite": "^7.0.0",
		"zustand": "^5.0.6"
	}
}
