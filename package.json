{
  "name": "ut-launcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/backend/main.cjs",
  "author": {
    "name": "P1ayer"
  },
  "description": "ut-app",
  "scripts": {
    "start": "concurrently --kill-others --names vite,electron -c green,cyan \"npm run vite:dev\" \"npm run electron:dev\"",
    "build": "npm run vite:build && npm run electron:package",
    "make": "npm run vite:build && npm run electron:make",
    "lint": "eslint .",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "electron:start": "electron-forge start",
    "electron:dev": "electron-forge start -- --dev",
    "electron:package": "electron-forge package",
    "electron:make": "electron-forge make"
  },
  "//": [
    "Do not bump 'electron-store@7.0.0' to latest version, it doesn't work because it's ESM converted"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.76.0",
    "axios": "^1.9.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^7.0.0",
    "js7z-tools": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "icon": "./public/icon/icon",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.25.1",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "sass-embedded": "^1.87.0",
    "vite": "^6.3.3"
  }
}
