{
  "name": "ut-launcher",
  "productName": "UT Launcher",
  "version": "0.0.1",
  "description": "Standalone launcher for downloading and patching games from the Unreal series",
  "main": ".vite/build/main.js",
  "icon": "./public/icon/icon",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:debug": "electron-forge start --inspect-electron",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint ./src",
    "vite": "vite --config ./vite.renderer.config.mts",
    "cloc": "cloc --exclude-ext=ini ./src"
  },
  "keywords": [],
  "author": {
    "name": "P1ayer"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.2",
    "@firefox-devtools/react-contextmenu": "^5.2.3",
    "@octokit/types": "^16.0.0",
    "@tanstack/react-query": "^5.100.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cloc": "^2.6.0-cloc",
    "electron": "^41.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-modal": "^3.16.3",
    "react-scan": "^0.5.3",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "zustand": "^5.0.12"
